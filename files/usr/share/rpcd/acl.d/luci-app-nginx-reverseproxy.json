{
	"luci-app-nginx-reverseproxy": {
		"description": "Grant UCI access for luci-app-nginx-reverseproxy",
		"read": {
			"uci": [ "nginx-reverseproxy" ],
			"ubus": {
				"service": [ "list" ],
				"log": [ "read" ]
			}
		},
		"write": {
			"uci": [ "nginx-reverseproxy" ],
			"file": {
				"/usr/sbin/nginx-reverseproxy-gen": [ "exec" ],
				"/etc/init.d/nginx-reverseproxy": [ "exec" ]
			}
		}
	}
}
